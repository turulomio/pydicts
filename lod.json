he first list of dictionaries.\n        lod2 (list): The second list of dictionaries.\n        calc_key (str): The key on which to perform the calculation.\n        operation (str, optional): The operation to perform (\"+\" or \"-\"). Defaults to \"+\".\n\n    Returns:\n        list: A new list of dictionaries with the combined results.\n\n"},"key":"CcXbu7phmx"}],"visibility":"show","key":"F5Zh0iXK60"}],"data":{"tags":[]},"visibility":"show","key":"OMlSJQ608W"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from pydicts import lod\n\nlod1 = [\n  {\"id\": 1, \"value\": 10, \"name\": \"A\"},\n  {\"id\": 2, \"value\": 20, \"name\": \"B\"} \n]\n\nlod2 = [\n  {\"id\": 1, \"value\": 5, \"name\": \"A\"},\n  {\"id\": 3, \"value\": 15, \"name\": \"C\"} \n]\n\nprint(\"Sum:\") \nlod.lod_print(lod.lod_join(lod1, lod2, calc_key=\"value\", operation=\"+\"))\n\nprint(\"\\nSubtraction:\")\nlod.lod_print(lod.lod_join(lod1, lod2, calc_key=\"value\", operation=\"-\"))","key":"wC32dorQpy"},{"type":"outputs","id":"X4zAisdXcRc7RsI0c2Kap","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"Sum:\n+------+---------+--------+\n|   id |   value | name   |\n|------+---------+--------|\n|    1 |      15 | A      |\n|    2 |      20 | B      |\n|    3 |      15 | C      |\n+------+---------+--------+\n\nSubtraction:\n+------+---------+--------+\n|   id |   value | name   |\n|------+---------+--------|\n|    1 |       5 | A      |\n|    2 |      20 | B      |\n|    3 |     -15 | C      |\n+------+---------+--------+\n"},"key":"nesIl6xd7B"}],"key":"AVwhcu0gSu"}],"key":"Z4jSJqPSqz"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":238,"column":1},"end":{"line":238,"column":1}},"children":[{"type":"text","value":"lod_keys","position":{"start":{"line":238,"column":1},"end":{"line":238,"column":1}},"key":"ogAgat3Bgc"}],"identifier":"lod-keys","label":"l