re is no limit. Defaults to None.\n        width (int, optional): The maximum desired output width. If None, uses terminal width. Defaults to None.\n        sort_dicts (bool, optional): If True, dictionary keys are sorted alphabetically. Defaults to True.\n\n    Returns:\n        None\n\n"},"key":"kvN2LvyvEW"}],"visibility":"show","key":"LdC2trByRd"}],"data":{"tags":[]},"visibility":"show","key":"c7IRc7PTXY"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from pydicts import dod\nfrom datetime import date, datetime\nfrom decimal import Decimal\nd={\"a\": datetime.now(), \"b\": date.today(), \"c\": Decimal('12.32'), \"d\": None, \"e\": int(12), \"f\":None, \"g\":True, \"h\":False,  \"nested\": {\"x\":1, \"y\":2, \"z\":{\"n\":4, \"m\":5, \"o\":6}}}\ndod_={}\ndod_[\"first\"]=d\ndod_[\"second\"]=d\ndod.dod_print(dod_)","key":"rB6OS9aLS6"},{"type":"outputs","id":"-djLnqTCpAgB8HbkbO95x","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"{   'first': {   'a': datetime.datetime(2026, 10, 11, 7, 37, 37, 542437),\n                 'b': datetime.date(2026, 10, 11),\n                 'c': Decimal('12.32'),\n                 'd': None,\n                 'e': 12,\n                 'f': None,\n                 'g': True,\n                 'h': False,\n                 'nested': {'x': 1, 'y': 2, 'z': {'m': 5, 'n': 4, 'o': 6}}},\n    'second': {   'a': datetime.datetime(2026, 10, 11, 7, 37, 37, 542437),\n                  'b': datetime.date(2026, 10, 11),\n                  'c': Decimal('12.32'),\n                  'd': None,\n                  'e': 12,\n                  'f': None,\n                  'g': True,\n                  'h': False,\n                  'nested': {'x': 1, 'y': 2, 'z': {'m': 5, 'n': 4, 'o': 6}}}}\n"},"key":"w4LRWqSfxB"}],"key":"fmCgYYVNNi"}],"key":"kTwumIpoY1"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line":