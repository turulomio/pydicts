here is no limit. Defaults to None.\n        width (int, optional): The maximum desired output width. If None, uses terminal width. Defaults to None.\n        sort_dicts (bool, optional): If True, dictionary keys are sorted alphabetically. Defaults to True.\n\n    Returns:\n        None\n\n"},"key":"S4vm86IamZ"}],"visibility":"show","key":"qgyt7v1die"}],"data":{"tags":[]},"visibility":"show","key":"xCAFYZxaL6"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from pydicts import dod\nfrom datetime import date, datetime\nfrom decimal import Decimal\nd={\"a\": datetime.now(), \"b\": date.today(), \"c\": Decimal('12.32'), \"d\": None, \"e\": int(12), \"f\":None, \"g\":True, \"h\":False,  \"nested\": {\"x\":1, \"y\":2, \"z\":{\"n\":4, \"m\":5, \"o\":6}}}\ndod_={}\ndod_[\"first\"]=d\ndod_[\"second\"]=d\ndod.dod_print(dod_)","key":"S0CYKqzv4P"},{"type":"outputs","id":"6W5t1cqbDReFLc7BjfFw5","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"{   'first': {   'a': datetime.datetime(2026, 11, 20, 7, 18, 21, 204112),\n                 'b': datetime.date(2026, 11, 20),\n                 'c': Decimal('12.32'),\n                 'd': None,\n                 'e': 12,\n                 'f': None,\n                 'g': True,\n                 'h': False,\n                 'nested': {'x': 1, 'y': 2, 'z': {'m': 5, 'n': 4, 'o': 6}}},\n    'second': {   'a': datetime.datetime(2026, 11, 20, 7, 18, 21, 204112),\n                  'b': datetime.date(2026, 11, 20),\n                  'c': Decimal('12.32'),\n                  'd': None,\n                  'e': 12,\n                  'f': None,\n                  'g': True,\n                  'h': False,\n                  'nested': {'x': 1, 'y': 2, 'z': {'m': 5, 'n': 4, 'o': 6}}}}\n"},"key":"CkHLBjzu1K"}],"key":"DYK6Yz0iTN"}],"key":"k38WcobQiy"},{"type":"block","children":[{"type":"heading","depth":2,"position":{"start":{"line