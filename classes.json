column":1},"end":{"line":134,"column":1}},"key":"NK9AGd4Fu8"},{"type":"inlineCode","value":"LOD","position":{"start":{"line":134,"column":1},"end":{"line":134,"column":1}},"key":"PYYVUUXpTW"},{"type":"text","value":" for Domain-Specific Logic","position":{"start":{"line":134,"column":1},"end":{"line":134,"column":1}},"key":"qLh8In9NrL"}],"identifier":"subclassing-lod-for-domain-specific-logic","label":"Subclassing LOD for Domain-Specific Logic","html_id":"subclassing-lod-for-domain-specific-logic","implicit":true,"key":"vohct9z6UY"},{"type":"paragraph","position":{"start":{"line":136,"column":1},"end":{"line":136,"column":1}},"children":[{"type":"text","value":"One of the greatest advantages of ","position":{"start":{"line":136,"column":1},"end":{"line":136,"column":1}},"key":"BI84ppHsNz"},{"type":"inlineCode","value":"LOD","position":{"start":{"line":136,"column":1},"end":{"line":136,"column":1}},"key":"mKUaOdB2Cg"},{"type":"text","value":" is the ability to subclass it to build dedicated domain models, encapsulating business rules, custom aggregations, and domain validations directly into the collection:","position":{"start":{"line":136,"column":1},"end":{"line":136,"column":1}},"key":"RWcYtESJPK"}],"key":"chDjrwxBbs"}],"key":"JkkPUJopm4"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"class Payroll(LOD):\n    \"\"\"Domain-specific LOD representing company payroll records.\"\"\"\n\n    def total_budget(self) -> Decimal:\n        \"\"\"Calculates total gross payroll.\"\"\"\n        return self.sum(\"salary\")\n\n    def department_payroll(self, dept_name: str) -> \"Payroll\":\n        \"\"\"Returns a new Payroll instance filtered by department.\"\"\"\n        return self.filter(lambda emp: emp[\"dept\"] == dept_name)\n\n    def top_earners(self, count: int = 3) -> \"Payroll\":\n        \"\"\"Returns the top earners ordered by salary.\"\"\"\n        cloned = self.clone()\n        cloned.order_by(\"salary\", reverse=True)\n        return cloned[:count]\n\n    def add_standard_bonus(self, bonus_rate: Decimal = Decimal(\"0.10\")) -> \"Payroll\":\n        \"\"\"Calculates and attaches the bonus field in place.\"\"\"\n        return self.calculate(\"bonus\", lambda emp: emp[\"salary\"] * bonus_rate)\n\n\n# Instantiate domain model\npayroll = Payroll(data, name=\"EngineeringPayroll\")\n\nprint(f\"Total budget: {payroll.total_budget()}\")\n\n# Filter by department returning another Payroll instance\nit_payroll = payroll.department_payroll(\"IT\")\nprint(f\"IT Budget: {it_payroll.total_budget()}\")\n\n# Method chaining and domain transformation\npayroll.add_standard_bonus(Decimal(\"0.15\"))\ntop_employees = payroll.top_earners(2)\ntop_employees.print()","key":"No3o6vF05E"},{"type":"outputs","id":"ztYvxeQsiyBi7DCBgBqUF","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"Total budget: 11700\nIT Budget: 6500\n┌──────┬─────────┬────────┬──────────┬──────────────────────┬─────────┐\n│   id │ name    │ dept   │   salary │   total_compensation │   bonus │\n├──────┼─────────┼────────┼──────────┼──────────────────────┼─────────┤\n│    3 │ Charlie │ IT     │     3500 │                 3850 │     525 │\n├──────┼─────────┼────────┼──────────┼──────────────────────┼─────────┤\n│    1 │ Alice   │ IT     │     3000 │                 3300 │     450 │\n└──────┴─────────┴────────┴──────────┴──────────────────────┴─────────┘\n"},"key":"eKvrDuacJd"}],"key":"uw578ozK27"}],"key":"G1aGjYOsXX"},{"type":"block","children":[{"type":"thematicBreak","position":{"start":{"line":176,"column":1},"end":{"line":176,"column":1}},"key":"qaBWRuixU9"},{"type":"heading","depth":2,"position":{"start":{"line":178,"column":1},"end":{"line":178,"column":1}},"children":[{"type":"text","value":"LOL (List of Lists)","position":{"start":{"line":178,"column":1},"end":{"line":178,"column":1}},"key":"gKrrWpgdUO"}],"identifier":"lol-list-of-lists","label":"LOL (List of