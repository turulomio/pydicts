,"column":1},"end":{"line":134,"column":1}},"key":"szpcEDX5hf"},{"type":"inlineCode","value":"LOD","position":{"start":{"line":134,"column":1},"end":{"line":134,"column":1}},"key":"KnfNEKAYxy"},{"type":"text","value":" for Domain-Specific Logic","position":{"start":{"line":134,"column":1},"end":{"line":134,"column":1}},"key":"VYZfHsYpuK"}],"identifier":"subclassing-lod-for-domain-specific-logic","label":"Subclassing LOD for Domain-Specific Logic","html_id":"subclassing-lod-for-domain-specific-logic","implicit":true,"key":"zWW4nUHre8"},{"type":"paragraph","position":{"start":{"line":136,"column":1},"end":{"line":136,"column":1}},"children":[{"type":"text","value":"One of the greatest advantages of ","position":{"start":{"line":136,"column":1},"end":{"line":136,"column":1}},"key":"Iiu568gb5c"},{"type":"inlineCode","value":"LOD","position":{"start":{"line":136,"column":1},"end":{"line":136,"column":1}},"key":"weasJZ57WN"},{"type":"text","value":" is the ability to subclass it to build dedicated domain models, encapsulating business rules, custom aggregations, and domain validations directly into the collection:","position":{"start":{"line":136,"column":1},"end":{"line":136,"column":1}},"key":"OkPRf7MusT"}],"key":"BqIawwrXr4"}],"key":"QGfuEHYgjA"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"class Payroll(LOD):\n    \"\"\"Domain-specific LOD representing company payroll records.\"\"\"\n\n    def total_budget(self) -> Decimal:\n        \"\"\"Calculates total gross payroll.\"\"\"\n        return self.sum(\"salary\")\n\n    def department_payroll(self, dept_name: str) -> \"Payroll\":\n        \"\"\"Returns a new Payroll instance filtered by department.\"\"\"\n        return self.filter(lambda emp: emp[\"dept\"] == dept_name)\n\n    def top_earners(self, count: int = 3) -> \"Payroll\":\n        \"\"\"Returns the top earners ordered by salary.\"\"\"\n        cloned = self.clone()\n        cloned.order_by(\"salary\", reverse=True)\n        return cloned[:count]\n\n    def add_standard_bonus(self, bonus_rate: Decimal = Decimal(\"0.10\")) -> \"Payroll\":\n        \"\"\"Calculates and attaches the bonus field in place.\"\"\"\n        return self.calculate(\"bonus\", lambda emp: emp[\"salary\"] * bonus_rate)\n\n\n# Instantiate domain model\npayroll = Payroll(data, name=\"EngineeringPayroll\")\n\nprint(f\"Total budget: {payroll.total_budget()}\")\n\n# Filter by department returning another Payroll instance\nit_payroll = payroll.department_payroll(\"IT\")\nprint(f\"IT Budget: {it_payroll.total_budget()}\")\n\n# Method chaining and domain transformation\npayroll.add_standard_bonus(Decimal(\"0.15\"))\ntop_employees = payroll.top_earners(2)\ntop_employees.print()","key":"vMbepyBYI8"},{"type":"outputs","id":"r9hr0efSyYDcpUwZjfkOK","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"stream","name":"stdout","text":"Total budget: 11700\nIT Budget: 6500\n┌──────┬─────────┬────────┬──────────┬──────────────────────┬─────────┐\n│   id │ name    │ dept   │   salary │   total_compensation │   bonus │\n├──────┼─────────┼────────┼──────────┼──────────────────────┼─────────┤\n│    3 │ Charlie │ IT     │     3500 │                 3850 │     525 │\n├──────┼─────────┼────────┼──────────┼──────────────────────┼─────────┤\n│    1 │ Alice   │ IT     │     3000 │                 3300 │     450 │\n└──────┴─────────┴────────┴──────────┴──────────────────────┴─────────┘\n"},"key":"wrPnMVAKvc"}],"key":"luMQXqbwJo"}],"key":"EEZEzdM3kh"},{"type":"block","children":[{"type":"thematicBreak","position":{"start":{"line":176,"column":1},"end":{"line":176,"column":1}},"key":"d3WPbDQK4z"},{"type":"heading","depth":2,"position":{"start":{"line":178,"column":1},"end":{"line":178,"column":1}},"children":[{"type":"text","value":"LOL (List of Lists)","position":{"start":{"line":178,"column":1},"end":{"line":178,"column":1}},"key":"PgQ737Isib"}],"identifier":"lol-list-of-lists","label":"LOL (List 